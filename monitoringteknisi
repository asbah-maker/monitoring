    window.copyRekapModem = function(mode) {
        if (mode === 'gudang') {
            let text = `📋 *REKAP GUDANG MODEM PUSAT*\n📅 ${new Date().toLocaleDateString('id-ID')}\n\n`;
            
            const nokiaReady = gudangStock.nokia.filter(i => i.status === 'ready' || !i.status).length;
            const fhReady = gudangStock.fh.filter(i => i.status === 'ready' || !i.status).length;
            const lainnyaReady = gudangStock.lainnya.filter(i => i.status === 'ready' || !i.status).length;
            
            text += `📊 *TOTAL STOK READY:*\n`;
            text += `• Modem Nokia: ${nokiaReady} unit\n`;
            text += `• Modem FH: ${fhReady} unit\n`;
            text += `• Modem Lainnya: ${lainnyaReady} unit\n\n`;
            
            const allItems = [...gudangStock.nokia, ...gudangStock.fh, ...gudangStock.lainnya];
            const badItems = allItems.filter(i => i.status === 'bad');
            const unknownItems = allItems.filter(i => i.status === 'unknown');
            
            if (badItems.length > 0) {
                text += `⚠️ *MODEM BAD (Total: ${badItems.length}):*\n`;
                badItems.forEach((item, idx) => {
                    text += `${idx+1}. ${item.sn} - ${item.teamName || 'Tidak diketahui'} (${item.badDate || 'Tanpa tanggal'})\n`;
                });
                text += `\n`;
            }
            
            if (unknownItems.length > 0) {
                text += `❓ *MODEM TIDAK DIKETAHUI (Total: ${unknownItems.length}):*\n`;
                unknownItems.forEach((item, idx) => {
                    text += `${idx+1}. ${item.sn} - ${item.teamName || 'Tidak diketahui'} (${item.unknownDate || 'Tanpa tanggal'})\n`;
                });
                text += `\n`;
            }
            
            copyToClipboard(text, null, "✅ Rekap Gudang Modem berhasil disalin!");
            closeRekapModemOption();
            return;
        }
        
        let text = `📋 *REKAP MODEM TEKNISI*\n📅 ${new Date().toLocaleDateString('id-ID')}\n`;
        text += mode === 'sisa' ? "(Hanya Stok Belum Terpasang)\n\n" : "(Semua: Sisa + Terpasang + Bad)\n\n";

        teams.forEach(team => {
            if(!team.inventory || team.inventory.length === 0) return;

            const uniqueInventory = getUniqueInventory(teams.indexOf(team));
            
            let items = [];
            if(mode === 'sisa') {
                items = uniqueInventory.filter(i => {
                    const status = getModemStatusGlobal(i.sn);
                    return status === 'pending';
                });
            } else {
                items = uniqueInventory;
            }

            if(items.length > 0) {
                text += `👤 *${team.teamName.toUpperCase()}* (${items.length} unit)\n`;
                items.forEach((item, idx) => {
                    const status = getModemStatusGlobal(item.sn);
                    const type = getModemType(item.sn); 
                    
                    let statusTag = "";
                    if(mode === 'all') {
                         if(status === 'installed') statusTag = " [TERPASANG]";
                         else if(status === 'bad') statusTag = " [BAD]";
                         else if(status === 'unknown') statusTag = " [TIDAK DIKETAHUI]";
                         else if(status === 'pending') statusTag = " [PENDING]";
                         else statusTag = " [READY]";
                    }
                    
                    text += `${idx+1}. ${item.sn} [${type}]${statusTag}\n`;
                });
                text += `--------------------\n`;
            }
        });

        navigator.clipboard.writeText(text).then(() => {
            alert("✅ Rekap Modem berhasil disalin ke Clipboard!");
            closeRekapModemOption();
        }).catch(err => {
            console.error("Gagal copy", err);
            const textArea = document.createElement("textarea");
            textArea.value = text;
            textArea.style.position = "fixed"; textArea.style.left = "-9999px";
            document.body.appendChild(textArea);
            textArea.select();
            document.execCommand('copy');
            document.body.removeChild(textArea);
            alert("✅ Rekap Modem berhasil disalin!");
            closeRekapModemOption();
        });
    }

