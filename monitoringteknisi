    // --- FUNGSI UNTUK MENGATASI DUPLIKAT DATA MODEM ---
    function getUniqueInventory(teamIndex) {
        const team = teams[teamIndex];
        if (!team || !team.inventory) return [];
        const seen = new Set();
        const uniqueInventory = [];
        for (const item of team.inventory) {
            if (!seen.has(item.sn)) {
                seen.add(item.sn);
                uniqueInventory.push(item);
            }
        }
        return uniqueInventory;
    }
    
    function checkForDuplicateModems(teamIndex) {
        const team = teams[teamIndex];
        if (!team || !team.inventory) return false;
        const seen = new Set();
        for (const item of team.inventory) {
            if (seen.has(item.sn)) {
                return true;
            }
            seen.add(item.sn);
        }
        return false;
    }

