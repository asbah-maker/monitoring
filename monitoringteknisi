    function formatDateIndo(dateStr) {
        if (!dateStr || dateStr === '-' || dateStr === "") return "-";
        
        const rawDate = dateStr.split(',')[0].trim(); 
        const parts = rawDate.split('/');

        if(parts.length === 3) {
            const months = ["JANUARI", "FEBRUARI", "MARET", "APRIL", "MEI", "JUNI", "JULI", "AGUSTUS", "SEPTEMBER", "OKTOBER", "NOVEMBER", "DESEMBER"];
            const day = parts[0];
            const monthIdx = parseInt(parts[1]) - 1;
            const year = parts[2];
            
            if(months[monthIdx]) {
                return `${day} ${months[monthIdx]} ${year}`;
            }
        }
        return rawDate;
    }

    window.downloadExcel = function(mode) {
        let dataToExport = [];
        const todayRaw = new Date().toLocaleString('id-ID');
        
        let rowNumber = 1;

        teams.forEach(team => {
            const rawTechName = team.teamName.split(':')[1]?.trim() || team.teamName;
            
            team.jobs.forEach((job) => {
                const isPSB = job.tag.toUpperCase().includes("PSB");
                
                if (mode === 'psb' && !isPSB) return;
                if (mode === 'non_psb' && isPSB) return;

                const d = job.details;
                const tech = job.technical || {};
                const addressParts = parseAddress(job.address);
                
                let rawDate = job.status === 'completed' ? (job.completedAt || todayRaw) : "-";
                if(isPSB && rawDate === "-") {
                    rawDate = d['Tgl Pasang'] || d['Tanggal Pemasangan'] || "-";
                }
                const finalDate = formatDateIndo(rawDate);

                if (mode === 'psb') {
                    dataToExport.push({
                        "No": rowNumber++,
                        "No layanan": d['No Layanan'] || d['Layanan'] || "-",
                        "Nama": job.name,
                        "Alamat": job.address,
                        "RT": addressParts.rt,
                        "RW": addressParts.rw,
                        "Kode Pos": "-",
                        "No Handphone": d['No WA'] || d['No Telp'] || "-",
                        "Tanggal pemasangan": finalDate,
                        "Paket Layanan": d['Paket'] || "-",
                    });
                } 
                else {
                    let kelurahan = d['Coverage']?.replace('Kel. ', '') || addressParts.kel;
                    if(kelurahan === '-') { 
                        if(job.address.includes("Jatinegara")) kelurahan = "Jatinegara";
                        if(job.address.includes("Cipinang")) kelurahan = "Cipinang";
                    }

                    let statusExcel = "Pending";
                    if(job.status === 'completed' || (job.completed && !job.status)) statusExcel = "Selesai";
                    else if(job.status === 'failed') statusExcel = "Gagal Kunjungan";

                    let catatanFull = d['Catatan'] || "-";
                    if(job.status === 'failed' && job.failureNote) {
                        if(catatanFull === "-") catatanFull = `GAGAL: ${job.failureNote}`;
                        else catatanFull += ` | GAGAL: ${job.failureNote}`;
                    }
                    if(job.status === 'completed' && job.completionNote) {
                        if(catatanFull === "-") catatanFull = `SOLUSI: ${job.completionNote}`;
                        else catatanFull += ` | SOLUSI: ${job.completionNote}`;
                    }

                    dataToExport.push({
                        "No": rowNumber++,
                        "No Layanan": d['No Layanan'] || d['Layanan'] || "-",
                        "Nama Pelanggan": job.name,
                        "Status Pengerjaan": statusExcel,
                        "Nomor Telpon": d['No WA'] || d['No Telp'] || "-",
                        "Tanggal Selesai Kunjungan": finalDate,
                        "Nama Teknisi": rawTechName,
                        "Alamat Lengkap": job.address,
                        "RT": addressParts.rt,
                        "RW": addressParts.rw,
                        "Area Kelurahan": kelurahan,
                        "SN": tech.sn || "-",
                        "Catatan": catatanFull,
                    });
                }
            });
        });

        if (dataToExport.length === 0) {
            alert("⚠️ Tidak ada data untuk kategori ini.");
            closeExcelOption();
            return;
        }

        const ws = XLSX.utils.json_to_sheet(dataToExport);
        
        if (mode === 'psb') {
            const wscols = [{wch: 5}, {wch: 20}, {wch: 30}, {wch: 40}, {wch: 5}, {wch: 5}, {wch: 10}, {wch: 15}, {wch: 25}, {wch: 20}];
