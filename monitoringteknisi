    function updateConnectionStatus(status, message) {
        const statusElement = document.getElementById('connection-status');
        let statusClass = 'connecting';
        let statusText = message;
        
        if (status === 'connected') {
            statusClass = 'connected';
            if (!message) statusText = '✅ Terhubung Online (Data Tersimpan)';
        } else if (status === 'disconnected') {
            statusClass = 'disconnected';
            if (!message) statusText = '❌ Terputus dari Server';
        } else if (status === 'connecting') {
            statusClass = 'connecting';
            if (!message) statusText = '🔄 Menghubungkan...';
        }
        
        statusElement.innerHTML = `
            <span class="connection-status ${statusClass}">
                <span class="status-dot"></span>
                ${statusText}
            </span>
        `;
        isFirebaseConnected = (status === 'connected');
        isOnline = navigator.onLine;
        
        if (status === 'disconnected' && appMode !== 'landing') {
            showSyncNotification('Koneksi terputus. Perubahan disimpan lokal.', 'warning', true, 5000);
        }
        
        if (status === 'connected' && pendingSyncOperations.length > 0) {
            showSyncNotification('Koneksi pulih. Menyinkronkan data...', 'saving');
            setTimeout(() => {
                retryPendingSyncOperations();
            }, 1000);
        }
    }
    
    function retryPendingSyncOperations() {
        if (pendingSyncOperations.length === 0 || !isFirebaseConnected) return;
        showSyncNotification(`Menyinkronkan ${pendingSyncOperations.length} operasi tertunda...`, 'saving');
        const retryCount = pendingSyncOperations.length;
        const successfulOps = [];
        pendingSyncOperations.forEach((op, index) => {
            try {
                if (op.type === 'teams') {
                    saveDataToFirebaseDirect();
                } else if (op.type === 'gudang') {
                    saveGudangToFirebaseDirect();
                }
                successfulOps.push(index);
            } catch (error) {
                console.error(`Gagal sinkron operasi ${index}:`, error);
            }
        });
        pendingSyncOperations = pendingSyncOperations.filter((_, index) => !successfulOps.includes(index));
        if (successfulOps.length > 0) {
            showSyncNotification(`Berhasil sinkron ${successfulOps.length} operasi`, 'success');
        }
        if (pendingSyncOperations.length > 0) {
            showSyncNotification(`Masih ada ${pendingSyncOperations.length} operasi tertunda`, 'warning');
        }
    }
    
    function addPendingSyncOperation(type) {
        pendingSyncOperations.push({
            type: type,
            timestamp: Date.now()
        });
        if (pendingSyncOperations.length > 10) {
            pendingSyncOperations.shift();
        }
        try {
            localStorage.setItem('pending_sync_ops', JSON.stringify(pendingSyncOperations));
        } catch (e) {
            console.error('Gagal menyimpan operasi tertunda:', e);
        }
    }
    
    function loadPendingSyncOperations() {
        try {
            const saved = localStorage.getItem('pending_sync_ops');
            if (saved) {
                pendingSyncOperations = JSON.parse(saved);
                const oneHourAgo = Date.now() - (60 * 60 * 1000);
                pendingSyncOperations = pendingSyncOperations.filter(op => op.timestamp > oneHourAgo);
                if (pendingSyncOperations.length > 0 && isFirebaseConnected) {
                    setTimeout(() => retryPendingSyncOperations(), 2000);
                }
            }
        } catch (e) {
            console.error('Gagal memuat operasi tertunda:', e);
        }
    }

