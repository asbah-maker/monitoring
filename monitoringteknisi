    window.cleanDuplicateModems = function() {
        const teamIndex = document.getElementById('btn-clean-duplicates').getAttribute('data-team-index');
        if (teamIndex === null) return;
        
        let pin = prompt("🔒 Masukkan PIN untuk membersihkan duplikat modem:");
        if (!checkPin(pin)) {
            alert("❌ PIN SALAH! Akses ditolak.");
            return;
        }
        
        const team = teams[teamIndex];
        if (!team || !team.inventory) return;
        
        const seen = new Set();
        const uniqueInventory = [];
        
        for (const item of team.inventory) {
            if (!seen.has(item.sn)) {
                seen.add(item.sn);
                uniqueInventory.push(item);
            }
        }
        
        const duplicateCount = team.inventory.length - uniqueInventory.length;
        
        if (duplicateCount > 0) {
            team.inventory = uniqueInventory;
            saveDataToFirebase();
            alert(`✅ Berhasil membersihkan ${duplicateCount} data duplikat!`);
            openStockListModal(parseInt(teamIndex));
        } else {
            alert("Tidak ada data duplikat ditemukan.");
        }
    }

