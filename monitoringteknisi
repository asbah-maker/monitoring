    window.processBulkInput = function() {
        const raw = document.getElementById('bulk-text').value;
        const type = document.getElementById('bulk-type').value;

        if(!raw.trim()) { alert("Data masih kosong!"); return; }

        let successCount = 0;
        const tokens = raw.replace(/[\n,]/g, ' ').trim().split(/\s+/);

        for (let i = 0; i < tokens.length; i += 2) {
            const sn = tokens[i];
            const mac = tokens[i + 1];

            if (sn && mac) {
                let exists = gudangStock[type].find(item => item.sn === sn);
                if(!exists) {
                    gudangStock[type].push({
                        sn: sn,
                        mac: mac,
                        status: 'ready'
                        // isLocked dihapus
                    });
                    successCount++;
                }
            }
        }

        if(successCount > 0) {
            saveGudangToFirebase();
            alert(`✅ Berhasil menambahkan ${successCount} Modem ke ${type.toUpperCase()}!`);
            closeBulkModal();
            document.getElementById('bulk-text').value = ''; 
            renderGudangTable(type);
            updateGudangCounts();
        } else {
            alert("⚠️ Tidak ada data baru yang ditambahkan atau format salah.\nPastikan urutannya: SN [spasi] MAC.");
        }
    }

    window.processModemAction = function(type, index, action) {
        const item = gudangStock[type][index];
        const notificationId = showSyncNotification('Memproses aksi modem...', 'saving', false);
        
        if (action === 'retur') {
            if(confirm(`⚠️ RETUR MODEM?\n\nApakah anda yakin menarik modem SN: ${item.sn} kembali ke Stok Ready?`)) {
                gudangStock[type][index].status = 'ready';
                gudangStock[type][index].teamName = '';
                gudangStock[type][index].teamId = null;
                gudangStock[type][index].pendingDate = null;
                gudangStock[type][index].installedDate = null;
                // isLocked dihapus
                finalizeAction();
            } else {
                closeSyncNotification(notificationId);
            }
        } else if (action === 'bad') {
            if(confirm(`⚠️ SET MODEM BAD?\n\nSN: ${item.sn} akan ditandai sebagai RUSAK/BAD.`)) {
                
                if (item.status === 'pending' || item.teamName) {
                    teams.forEach(t => {
                        if(t.inventory) {
                            const invIndex = t.inventory.findIndex(inv => inv.sn === item.sn);
                            if(invIndex > -1) {
                                t.inventory.splice(invIndex, 1);
                            }
                        }
                    });
                    saveDataToFirebase();
                }

                gudangStock[type][index].status = 'bad';
                gudangStock[type][index].teamName = item.teamName || '';
                gudangStock[type][index].teamId = item.teamId || null;
                gudangStock[type][index].badDate = new Date().toLocaleString('id-ID');
                
                finalizeAction();
            } else {
                closeSyncNotification(notificationId);
            }
        } else if (action === 'reset') {
             if(confirm(`Kembalikan modem BAD/UNKNOWN (SN: ${item.sn}) menjadi READY?`)) {
                gudangStock[type][index].status = 'ready';
                // isLocked dihapus
                finalizeAction();
             } else {
                closeSyncNotification(notificationId);
             }
        }

        function finalizeAction() {
            saveGudangToFirebase();
            renderGudangTable(type);
            updateGudangCounts();
            renderJobs(); 
            showSyncNotification('Aksi modem berhasil diproses', 'success');
            closeSyncNotification(notificationId);
        }
    }

