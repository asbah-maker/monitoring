    let appMode = 'landing'; // landing, admin, tech
    let selectedTechIndex = -1; // -1 means no tech selected

    // --- PIN ADMIN TERSAMAR (XOR dengan 85) ---
    const ENC_PIN = [101,98,109,108]; // Hasil XOR 85 dari "0789"
    function checkPin(input) {
        if (!input || input.length !== 4) return false;
        for (let i = 0; i < 4; i++) {
            if ((input.charCodeAt(i) ^ 85) !== ENC_PIN[i]) return false;
        }
        return true;
    }

    // --- SYNC NOTIFICATION SYSTEM ---
    
    function showSyncNotification(message, type = 'saving', autoClose = true, duration = 3000) {
        const container = document.getElementById('sync-notification-container');
        if (syncNotificationTimeout) {
            clearTimeout(syncNotificationTimeout);
            syncNotificationTimeout = null;
        }
        const notification = document.createElement('div');
        notification.className = `sync-notification ${type}`;
        notification.id = `sync-notification-${Date.now()}`;
        
        let icon = '⏳';
        if (type === 'success') icon = '✅';
        else if (type === 'error') icon = '❌';
        else if (type === 'warning') icon = '⚠️';
        else if (type === 'saving') icon = '🔄';
        
        notification.innerHTML = `
            <span class="sync-icon">${icon}</span>
            <span class="sync-message">${message}</span>
            <button class="sync-close" onclick="closeSyncNotification('${notification.id}')">×</button>
        `;
        container.appendChild(notification);
        
        if (autoClose && type !== 'saving') {
            syncNotificationTimeout = setTimeout(() => {
