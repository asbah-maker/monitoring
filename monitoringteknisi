        const raw = document.getElementById('bulk-input-text').value;
        const container = document.getElementById('preview-container');
        container.innerHTML = '';

        if (!raw.trim()) { 
            alert("Paste data dulu!"); 
            return; 
        }

        const tickets = raw.split(/\n\s*\n/);
        let psbCount = 0;
        let mtCount = 0;
        let isolirCount = 0;

        tickets.forEach((ticketText, index) => {
            ticketText = ticketText.trim();
            if (!ticketText) return;

            const hasKendala = ticketText.toLowerCase().includes('kendala:');
            const hasNamaLengkap = ticketText.toLowerCase().includes('nama lengkap :');
            
            if (hasNamaLengkap) {
                createPSBCard(ticketText, index, container);
                psbCount++;
            } else if (hasKendala) {
                createMTCard(ticketText, index, container);
                if (ticketText.toLowerCase().includes('kendala: isolir')) {
                    isolirCount++;
                } else {
                    mtCount++;
                }
            } else {
                if (ticketText.toLowerCase().includes('nama pelanggan:')) {
                    createMTCard(ticketText, index, container);
                    mtCount++;
                } else {
                    createMTCard(ticketText, index, container);
                    mtCount++;
                }
            }
        });

        if (psbCount === 0 && mtCount === 0 && isolirCount === 0) {
            alert("❌ Tidak ada tiket yang terdeteksi. Periksa format data!");
        } else {
            alert(`✅ SMART GENERATE SELESAI!\nDitemukan:\n- ${psbCount} Tiket PSB\n- ${mtCount} Tiket MT (Lain)\n- ${isolirCount} Tiket ISOLIR`);
        }
    }

