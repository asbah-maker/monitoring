            let selectedMembers = [t1.toLowerCase()];
            if(t2 && t2 !== "") selectedMembers.push(t2.toLowerCase());
            selectedMembers.sort(); 

            let targetTeamIndex = teams.findIndex(team => {
                const members = team.members ? team.members : [];
