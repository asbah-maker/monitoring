    window.processTransfer = function() {
        const sourceIdx = document.getElementById('transfer-source-team').value;
        const targetVal = document.getElementById('transfer-target-team').value;
        
        if(sourceIdx === "" || targetVal === "") { alert("Lengkapi pilihan tim!"); return; }

        const cbs = document.querySelectorAll('.job-transfer-cb:checked');
        if(cbs.length === 0) { alert("Pilih minimal 1 tiket untuk dilempar!"); return; }

        let jobIndices = Array.from(cbs).map(cb => parseInt(cb.value)).sort((a,b) => b-a);
        let jobsToMove = [];

        jobIndices.forEach(idx => {
            jobsToMove.push(teams[sourceIdx].jobs[idx]);
        });

        let targetTeamIdx;

        if (targetVal === 'new_team') {
            const t1 = document.getElementById('transfer-new-tech-1').value;
            const t2 = document.getElementById('transfer-new-tech-2').value;
            if(!t1) { alert("Pilih teknisi untuk tim baru!"); return; }

            let selectedMembers = [t1.toLowerCase()];
            if(t2) selectedMembers.push(t2.toLowerCase());
            selectedMembers.sort();

            const newId = Date.now(); 
            const colorIndex = (teams.length) % extraColors.length; 
            
            const usedNumbers = teams.map(t => {
                const match = t.teamName.match(/Tim\s+(\d+)/i);
                return match ? parseInt(match[1]) : 0;
            });
            let nextNum = 1;
            while (usedNumbers.includes(nextNum)) nextNum++;
            
            const teamNameStr = `Tim ${nextNum}: ${t1}${t2 ? ' & '+t2 : ''}`;

            const newTeamObj = {
                id: newId,
                teamName: teamNameStr,
                colorClass: extraColors[colorIndex] || "bg-dark",
                members: selectedMembers,
                jobs: [],
                inventory: []
            };
            teams.push(newTeamObj);
            targetTeamIdx = teams.length - 1;

        } else {
            targetTeamIdx = parseInt(targetVal);
        }

        jobsToMove.forEach(j => {
            teams[targetTeamIdx].jobs.push(j);
        });

        jobIndices.forEach(idx => {
            teams[sourceIdx].jobs.splice(idx, 1);
        });

        saveDataToFirebase();
        alert(`✅ Berhasil melempar ${jobsToMove.length} tiket ke ${teams[targetTeamIdx].teamName}!`);
        closeTransferModal();
    }

