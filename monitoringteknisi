            const item = gudangStock[type][index];
            teams.forEach(t => {
                if (t.inventory) {
                    const invIndex = t.inventory.findIndex(inv => inv.sn === item.sn);
                    if (invIndex > -1) {
                        t.inventory.splice(invIndex, 1);
