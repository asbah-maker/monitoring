    function loadFirebaseData() {
        updateConnectionStatus('connecting', 'Menghubungkan ke Firebase...');
        loadBackupData();
        loadPendingSyncOperations();
        
        window.addEventListener('online', function() {
            updateConnectionStatus('connecting', 'Koneksi pulih, menyinkronkan...');
            setTimeout(() => {
                if (isFirebaseConnected) {
                    updateConnectionStatus('connected');
                }
            }, 1000);
        });
        
        window.addEventListener('offline', function() {
            updateConnectionStatus('disconnected', 'Koneksi internet terputus');
            showSyncNotification('Anda sedang offline. Perubahan akan disimpan lokal.', 'warning', true, 5000);
        });
        
        const connectedRef = ref(db, ".info/connected");
        onValue(connectedRef, (snap) => {
            if (snap.val() === true) {
                isFirebaseConnected = true;
                updateConnectionStatus('connected');
                
                onValue(dbRef, (snapshot) => {
                    const data = snapshot.val();
                    document.getElementById('loading-text').style.display = 'none';
                    
                    if (data) {
                        teams = data;
                        teams.forEach(t => { 
                            if(!t.inventory) t.inventory = []; 
                            if (t.inventory && t.inventory.length > 0) {
                                const seen = new Set();
                                const uniqueInventory = [];
                                for (const item of t.inventory) {
                                    if (!seen.has(item.sn)) {
                                        seen.add(item.sn);
                                        uniqueInventory.push(item);
                                    }
                                }
                                t.inventory = uniqueInventory;
                            }
                        });
                    } else {
                        teams = JSON.parse(JSON.stringify(defaultTeams));
                    }

                    renderLandingTeams(); 

                    if (appMode === 'tech' && selectedTechIndex !== -1) {
                        renderJobs();
                    } else if (appMode === 'admin') {
                        renderJobs();
                    }
                    
                    if(gudangStock.nokia || gudangStock.fh || gudangStock.lainnya) {
                        syncInstalledModems();
                    }
                });

                onValue(gudangRef, (snapshot) => {
                    const data = snapshot.val();
                    if (data) {
                        gudangStock = data;
                        if(!gudangStock.nokia) gudangStock.nokia = [];
                        if(!gudangStock.fh) gudangStock.fh = [];
                        if(!gudangStock.lainnya) gudangStock.lainnya = [];
                        
                        // Pastikan setiap item punya status
                        [...gudangStock.nokia, ...gudangStock.fh, ...gudangStock.lainnya].forEach(item => {
                            if (!item.status || item.status === '') item.status = 'ready';
                        });
                    } else {
                        // Jangan timpa data lokal dengan kosong
                        if (gudangStock.nokia.length === 0 && gudangStock.fh.length === 0 && gudangStock.lainnya.length === 0) {
                            gudangStock = { nokia: [], fh: [], lainnya: [] };
                        }
                    }
                    
                    updateGudangCounts();
                    if(document.getElementById("modalGudang").style.display === "block") {
                        renderGudangTable(currentGudangTab);
                    }
                    
                    if (appMode !== 'landing') {
                        renderJobs();
                    }
                });
                
            } else {
                isFirebaseConnected = false;
                updateConnectionStatus('disconnected', 'Terputus dari Firebase');
            }
        }, (error) => {
            console.error("Error monitoring connection:", error);
            isFirebaseConnected = false;
            updateConnectionStatus('disconnected', 'Gagal terhubung ke Firebase');
            document.getElementById('loading-text').style.display = 'none';
            renderLandingTeams();
        });
    }
    
