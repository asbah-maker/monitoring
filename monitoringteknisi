    // --- FITUR UPLOAD RESTORE (JSON) ---
    window.uploadBackup = function(event) {
        const file = event.target.files[0];
        if (!file) return;

        const reader = new FileReader();
        reader.onload = function(e) {
            try {
                const backupData = JSON.parse(e.target.result);
                
                // Validasi struktur data
                if (!backupData.teams || !Array.isArray(backupData.teams)) {
                    throw new Error("Format file tidak valid: 'teams' tidak ditemukan atau bukan array.");
                }
                if (!backupData.gudangStock || typeof backupData.gudangStock !== 'object') {
                    throw new Error("Format file tidak valid: 'gudangStock' tidak ditemukan.");
                }

                // Konfirmasi restore
                if (confirm("⚠️ Yakin ingin merestore data dari file ini? Data yang ada sekarang akan ditimpa!")) {
                    // Timpa data lokal
                    teams = backupData.teams;
                    gudangStock = backupData.gudangStock;

                    // Pastikan struktur gudangStock lengkap (nokia, fh, lainnya)
                    if (!gudangStock.nokia) gudangStock.nokia = [];
                    if (!gudangStock.fh) gudangStock.fh = [];
                    if (!gudangStock.lainnya) gudangStock.lainnya = [];

                    // Simpan ke Firebase
                    Promise.all([saveDataToFirebaseDirect(), saveGudangToFirebaseDirect()])
                        .then(() => {
                            showSyncNotification('✅ Restore data berhasil!', 'success');
                            // Refresh tampilan
                            renderJobs();
                            renderLandingTeams();
                            updateGudangCounts();
                        })
                        .catch((err) => {
                            showSyncNotification('❌ Gagal menyimpan ke Firebase!', 'error');
                            console.error(err);
                        });
                }
            } catch (error) {
                alert("❌ Gagal membaca file JSON: " + error.message);
            } finally {
                // Reset input file
                event.target.value = '';
            }
        };
        reader.readAsText(file);
    };

